DJANGO_SECRET_KEY=replace-with-your-local-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

MAX_UPLOAD_SIZE_MB=100

# absolute path to a checkpoint made by ml.train_head or ml.finetune
MODEL_CHECKPOINT_PATH=
MODEL_VERSION=veritas-v2
SAMPLED_FRAMES=16
USE_IMAGENET_WEIGHTS=False
# refuse videos where a face is visible in fewer than this share of frames
MIN_FACE_RATIO=0.5
# |p - threshold| below this is flagged low-confidence
UNCERTAIN_BAND=0.1
